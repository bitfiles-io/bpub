{
  "name": "@bitfiles/bpub",
  "version": "0.1.2",
  "description": "TypeScript port of the bpub Python library: read, write, and sign BPUB data inscriptions embedded in Bitcoin transactions. Isomorphic (Node + browser); standard Bitcoin plumbing and signing are built on @scure/btc-signer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfiles-io/bpub.git"
  },
  "sideEffects": false,
  "keywords": [
    "bitcoin",
    "bpub",
    "inscription",
    "p2wsh",
    "segwit"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "serve": "node --version >/dev/null && npx --yes http-server . -p 8099 -c-1"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/btc-signer": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
